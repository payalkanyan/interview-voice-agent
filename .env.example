# Provider API keys. Copy to .env and fill in; never commit .env.
# Smart Turn v3 needs no key: Pipecat bundles the model weights.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Either name works; the Gemini SDK recognises both.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Voice. Pick any Cartesia voice id from their voice library.
CARTESIA_VOICE_ID=

# Models. See docs/DESIGN.md for why these exact strings.
DEEPGRAM_MODEL=nova-3-general
CARTESIA_MODEL=sonic-3.6
GEMINI_CONVERSATION_MODEL=gemini-3.1-flash-lite

# Comma-separated keyterms to boost STT accuracy on interview vocabulary.
DEEPGRAM_KEYTERMS=

# Turn-taking. Defaults below match Pipecat's own defaults; see README for what I changed and why.
# VAD (pipecat defaults: 0.7 / 0.2 / 0.2 / 0.6)
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.2
VAD_MIN_VOLUME=0.6

# Smart Turn v3 (pipecat defaults: 3.0 / 500.0 / 8.0)
SMART_TURN_STOP_SECS=3.0
SMART_TURN_PRE_SPEECH_MS=500.0
SMART_TURN_MAX_DURATION_SECS=8.0

# Words required to interrupt the coach while it is speaking. 1 word never interrupts a
# normal turn start, so this only filters coughs and backchannels.
INTERRUPT_MIN_WORDS=2

# Stronger model for the closing feedback, called separately from the conversation.
GEMINI_FEEDBACK_MODEL=gemini-3.8-flash

# Where per-session transcripts and latency logs are written.
LOG_DIR=logs

# Model used by the transcript eval's LLM judge.
EVAL_JUDGE_MODEL=gemini-3.8-flash
